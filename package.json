{
    "name": "vscode-choral",
    "displayName": "Choral Language Extension",
    "description": "Support for the Choral programming language.",
    "version": "1.0.4",
    "license": "MIT",
    "icon": "./images/icon.png",
    "publisher": "choral",
    "engines": {
        "vscode": "^1.91.0"
    },
    "contributors": [
        {
            "name": "Fabrizio Montesi",
            "email": "famontesi@gmail.com",
            "url": "https://www.fabriziomontesi.com"
        },
        {
            "name": "Lovro Lugović",
            "email": "lugovic@imada.sdu.dk"
        },
        {
            "name": "Malthe Hedelund Petersen",
            "email": "malpe21@student.sdu.dk"
        },
        {
            "name": "Dan Plyukhin",
            "email": "dplyukhin@gmail.com",
            "url": "https://dplyukhin.github.io"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/choral-lang/vscode-choral"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "choral",
                "aliases": [
                    "Choral",
                    "choral"
                ],
                "extensions": [
                    ".ch",
                    ".chh"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./images/icon-small.png",
                    "dark": "./images/icon-small.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "choral",
                "scopeName": "source.choral",
                "path": "./syntaxes/choral.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "choral.insertComms",
                "title": "Insert Missing Communications",
                "category": "Choral"
            }
        ],
        "configuration": {
            "title": "Choral",
            "properties": {
                "choral.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 100,
                    "description": "Maximum number of problems reported"
                },
                "choral.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces communication between VSCode and language server"
                }
            }
        },
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "role.type.choral",
                        "settings": {
                            "foreground": "#ff8000"
                        }
                    }
                ]
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "npm run compile && mocha \"out/test/unit/**/*.test.js\"",
        "test:integration": "npm run compile && vscode-test --label integration",
        "test:e2e": "npm run compile && vscode-test --label e2e",
        "test:e2e:install": "npm run compile && vscode-test --label e2e-install",
        "deploy": "vsce publish"
    },
    "dependencies": {
        "adm-zip": "^0.6.1",
        "vscode-languageclient": "^10.1.1"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.5",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "^1.79.2",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^9.34.0",
        "mocha": "^11.8.0",
        "typescript": "^5.9.2"
    },
    "overrides": {
        "diff": "8.0.4",
        "serialize-javascript": "7.1.2"
    }
}
